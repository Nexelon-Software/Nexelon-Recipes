# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth (32+ chars; e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Google OAuth (Better Auth)
# Authorized redirect URI in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google  (local)
#   https://<your-domain>/api/auth/callback/google  (production)
#
# Phone / LAN testing: Google blocks OAuth when redirect_uri is a bare private IP
# ("device_id and device_name are required for private IP"). Dev middleware
# redirects 192.168.x.x → 192.168.x.x.nip.io automatically; you must still add
# in Google Cloud Console (Credentials → OAuth client):
#   JavaScript origin: http://192.168.1.113.nip.io:3000
#   Redirect URI:      http://192.168.1.113.nip.io:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexelon_recipes"

# App URL (metadata, canonical links)
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"
